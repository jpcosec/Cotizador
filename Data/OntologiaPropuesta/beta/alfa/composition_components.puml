@startuml CompositionComponents
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam ArrowColor #666666
skinparam defaultFontName Arial
left to right direction

title Composicion del modelo

package "Primitivas base" {
  [Propiedad Activa]
  [Propiedad Descriptiva]
  [OP_CLASS]
  [Area]
  [Ruling]
  [Pricing]
}

package "Capa comercial" {
  [Categoria]
}

package "Contrato derivado" {
  [ContratoItem]
}

package "Instancia concreta" {
  [ItemCatalogo]
  [LineaCotizada]
  [Cotizacion]
}

[OP_CLASS] --> [Propiedad Activa] : define estructura
[OP_CLASS] --> [Propiedad Descriptiva] : define estructura
[OP_CLASS] --> [Ruling] : define patron base
[OP_CLASS] --> [Pricing] : define patron base

[Area] --> [Ruling] : agrega dominio

[Categoria] --> [Area] : cuelga de
[Categoria] --> [OP_CLASS] : habilita / restringe
[Categoria] --> [Ruling] : modula
[Categoria] --> [Pricing] : modula
[Categoria] --> [Propiedad Activa] : override default / constraint
[Categoria] --> [Propiedad Descriptiva] : override default

[Area] --> [ContratoItem] : semantica de dominio
[OP_CLASS] --> [ContratoItem] : contrato estructural
[Categoria] --> [ContratoItem] : contexto comercial

[ContratoItem] --> [ItemCatalogo] : define item instanciable
[ItemCatalogo] --> [Propiedad Activa] : preconfigura
[ItemCatalogo] --> [Propiedad Descriptiva] : preconfigura
[ItemCatalogo] --> [LineaCotizada] : se compra como
[LineaCotizada] --> [Cotizacion] : pertenece a
[LineaCotizada] --> [Propiedad Activa] : fija valor efectivo
[LineaCotizada] --> [Ruling] : dispara / override local
[LineaCotizada] --> [Pricing] : resuelve / override local

note right of [OP_CLASS]
Las propiedades estructurales nacen aqui.
No nacen en Categoria.
end note

note right of [Categoria]
Puede modular defaults o restricciones,
pero no inventar estructura nueva.
end note

note right of [LineaCotizada]
Ultima capa de materializacion.
Aqui vive el valor runtime.
end note
@enduml
