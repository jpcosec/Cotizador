        <mxCell id="infra_tipo" value="&lt;b&gt;INFRA_TIPO&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Infra_Tipo&lt;br/&gt;Nombre&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ejemplos&lt;/b&gt;&lt;br/&gt;consumible, personal, locacion, equipamiento&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Clase de recurso operativo necesario para ejecutar o habilitar el item." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
