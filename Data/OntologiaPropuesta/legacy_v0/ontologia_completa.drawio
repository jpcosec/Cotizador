        <mxCell id="horario" value="&lt;b&gt;HORARIO&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Horario&lt;br/&gt;Modo&lt;br/&gt;Hora_Inicio_Default&lt;br/&gt;Duracion_Default&lt;br/&gt;Flexibilidad&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Dimension temporal del item: bloque diurno, 4h noche, por dia, por noche, extra horario, etc." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="420" width="320" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="valorizacion" value="&lt;b&gt;TIPO_VALORIZACION&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Tipo_Valorizacion&lt;br/&gt;Codigo&lt;br/&gt;Unidad_Base&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ejemplos&lt;/b&gt;&lt;br/&gt;flat, per_person, per_unit, base_plus_variable, time&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Como se computa la cantidad economica del item." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
