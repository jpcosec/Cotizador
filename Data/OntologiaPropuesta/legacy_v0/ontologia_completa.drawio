        <mxCell id="locacion" value="&lt;b&gt;LOCACION&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Locacion&lt;br/&gt;Nombre&lt;br/&gt;Tipo_Locacion&lt;br/&gt;Capacidad_Base&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ejemplos&lt;/b&gt;&lt;br/&gt;Salon, piscina, terraza, habitacion, cabana, outdoor sector&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Lugar fisico donde ocurre o se consume el item." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
