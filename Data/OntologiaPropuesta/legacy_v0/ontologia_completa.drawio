  <diagram id="ontologia-completa" name="Ontologia completa">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;font style=&quot;font-size:22px;&quot;&gt;&lt;b&gt;CotizadorLodge - Ontologia completa propuesta&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;Modelo conceptual: dimensiones que componen cada ITEM_CATALOGO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="470" y="20" width="560" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Convencion&lt;/b&gt;&lt;br&gt;- Azul: entidad central&lt;br&gt;- Verde: dimensiones maestras&lt;br&gt;- Amarillo: tablas puente / asignacion&lt;br&gt;- Naranja: comportamiento comercial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="20" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="item" value="&lt;b&gt;ITEM_CATALOGO&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Item&lt;br/&gt;Nombre_Comercial&lt;br/&gt;Descripcion&lt;br/&gt;ID_Categoria_Comercial&lt;br/&gt;Activo&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Unidad comercial cotizable. No define todo internamente: se compone por dimensiones." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="190" width="500" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="categoria" value="&lt;b&gt;CATEGORIA_COMERCIAL&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Categoria_Comercial&lt;br/&gt;Nombre&lt;br/&gt;Dominio&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Agrupacion de navegacion: Alojamiento, Gastronomia, Actividades, Wellness, Infra, Operacional." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="tipo_cliente" value="&lt;b&gt;TIPO_CLIENTE&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Tipo_Cliente&lt;br/&gt;Nombre&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ejemplos&lt;/b&gt;&lt;br/&gt;persona, empresa&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Segmento del comprador o del uso comercial habilitado para el item." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
