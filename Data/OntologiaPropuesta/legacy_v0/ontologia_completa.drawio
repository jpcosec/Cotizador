          <mxGeometry x="390" y="680" width="360" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="item_infra" value="&lt;b&gt;ITEM_INFRA_REQUERIDA&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Item_Infra&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; ID_Item&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; ID_Infra_Recurso&lt;br/&gt;Cantidad_Default&lt;br/&gt;Obligatorio&lt;br/&gt;Modo_Consumo&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Tabla puente que dice que recursos necesita o habilita cada item." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="690" width="340" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="precio" value="&lt;b&gt;PERFIL_PRECIO&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Perfil_Precio&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; ID_Tipo_Valorizacion&lt;br/&gt;Costo_Base_Fijo&lt;br/&gt;Costo_Unitario_Pax&lt;br/&gt;Costo_Unitario_Item&lt;br/&gt;Costo_Unitario_Tiempo&lt;br/&gt;Moneda&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Regla numerica del calculo economico." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="680" width="300" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="regla" value="&lt;b&gt;REGLA_NEGOCIO&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Regla&lt;br/&gt;Scope&lt;br/&gt;Etapa&lt;br/&gt;Condicion_JSON&lt;br/&gt;Payload_JSON&lt;br/&gt;Prioridad&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Restriccion, warning o dependencia que modifica disponibilidad o comportamiento del item." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="950" width="320" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="item_regla" value="&lt;b&gt;ITEM_REGLA&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;PK&lt;/b&gt; ID_Item_Regla&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; ID_Item&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; ID_Regla&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Significado&lt;/b&gt;&lt;br/&gt;Permite ligar reglas directas a un item concreto, sin perder reglas por categoria o por recurso." style="shape=table;startSize=28;container=0;collapsible=0;childLayout=stackLayout;rowLines=1;columnLines=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="960" width="300" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="nota" value="&lt;b&gt;Lectura propuesta&lt;/b&gt;&lt;br&gt;1. Las categorias comerciales sirven para navegar.&lt;br&gt;2. El item se define por dimensiones composables.&lt;br&gt;3. Precio y reglas son capas de comportamiento, no categorias.&lt;br&gt;4. Infra deja de ser bolsa mixta y pasa a ser recurso tipado + relacion con item." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="970" width="500" height="170" as="geometry"/>
        </mxCell>
