@startuml EjemplosTipados
hide circle
skinparam backgroundColor white
skinparam ArrowColor #666666
skinparam classAttributeIconSize 0

title Ejemplos de tipado

object "Buffet desayuno empresa" as buffet {
  area = cocina
  tipo_item = servicio
  subtipo = agendable?
  clase = BuffetDesayuno
  categoria = Gastronomia
  facetas = Vendible, Agendable,
            RequiereLocacion,
            RequiereHorario,
            RequierePax,
            RequiereInfra,
            TienePrecio,
            TieneReglas
  valorizacion = per_person
}

object "Sandwich unitario" as sandwich {
  area = cocina
  tipo_item = producto
  subtipo = consumible
  clase = Sandwich
  categoria = Gastronomia
  facetas = Vendible,
            Consumible,
            EsUnitario,
            TienePrecio
  valorizacion = per_unit
}

object "Teambuilding Naufrago" as naufrago {
  area = teambuilding
  tipo_item = compuesto
  subtipo = evento
  clase = TeambuildingGuiado
  categoria = Actividades
  facetas = Vendible, Agendable,
            RequiereLocacion,
            RequiereHorario,
            RequierePax,
            RequiereInfra,
            TienePrecio,
            TieneReglas
  valorizacion = flat + per_person?
}

object "Salon Chinook" as salon {
  area = infraestructura
  tipo_item = recurso
  subtipo = locacion
  clase = SalonEvento
  categoria = Infraestructura
  facetas = TieneCapacidad,
            RequiereHorario,
            TienePrecio,
            TieneReglas
  valorizacion = flat or time
}
@enduml
