@startuml ClasesComponentes
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam ArrowColor #666666
skinparam defaultFontName Arial
left to right direction

title Componentes del sistema tipado desde CLASE_CATALOGO

package "Navegacion comercial" {
  [CATEGORIA_COMERCIAL]
}

package "Base semantica" {
  [AREA]
  [TIPO_ITEM]
  [SUBTIPO_ITEM]
}

package "Capacidades transversales" {
  [FACETA]
}

package "Plantillas reutilizables" {
  [CLASE_CATALOGO]
  [CLASE_FACETA]
  [CLASE_DIMENSIONES]
  [CLASE_PRECIO]
  [CLASE_REGLA]
  [CLASE_INFRA]
}

package "Instancias concretas" {
  [ITEM_CATALOGO]
  [ITEM_OVERRIDE]
}

package "Dimensiones maestras" {
  [TIPO_CLIENTE]
  [LOCACION]
  [HORARIO]
  [TIPO_VALORIZACION]
  [INFRA_TIPO]
  [INFRA_RECURSO]
}

package "Comportamiento" {
  [PERFIL_PRECIO]
  [REGLA_NEGOCIO]
}

[CATEGORIA_COMERCIAL] --> [CLASE_CATALOGO] : agrupa familias
[AREA] --> [CLASE_CATALOGO] : dominio del negocio
[TIPO_ITEM] --> [SUBTIPO_ITEM] : especializa
[TIPO_ITEM] --> [CLASE_CATALOGO] : tipa operativamente
[SUBTIPO_ITEM] --> [CLASE_CATALOGO] : matiza
[FACETA] --> [CLASE_FACETA] : catalogo de capacidades
[CLASE_CATALOGO] --> [CLASE_FACETA] : declara facetas base
[CLASE_CATALOGO] --> [CLASE_DIMENSIONES] : declara dimensiones default
[CLASE_CATALOGO] --> [CLASE_PRECIO] : declara precio base
[CLASE_CATALOGO] --> [CLASE_REGLA] : declara reglas base
[CLASE_CATALOGO] --> [CLASE_INFRA] : declara infra base

[TIPO_CLIENTE] --> [CLASE_DIMENSIONES] : opcion posible
[LOCACION] --> [CLASE_DIMENSIONES] : opcion posible
[HORARIO] --> [CLASE_DIMENSIONES] : opcion posible
[TIPO_VALORIZACION] --> [PERFIL_PRECIO] : formula
[PERFIL_PRECIO] --> [CLASE_PRECIO] : base
[REGLA_NEGOCIO] --> [CLASE_REGLA] : base
[INFRA_TIPO] --> [INFRA_RECURSO] : tipa
[INFRA_RECURSO] --> [CLASE_INFRA] : base

[CLASE_CATALOGO] --> [ITEM_CATALOGO] : instancia concreta
[ITEM_CATALOGO] --> [ITEM_OVERRIDE] : overridea defaults

note right of [CLASE_CATALOGO]
Es la pieza clave para reuso.
Ejemplo: Sandwich, BuffetDesayuno,
HabitacionHotel, Masaje30Min.
end note

note right of [TIPO_ITEM]
servicio = prestacion
producto = consumo/inventario
recurso = personal/equipamiento/locacion
compuesto = evento/pack/programa
end note

note right of [ITEM_CATALOGO]
Representa la variante vendible.
Ejemplo: Sandwich ave mayo,
Sandwich vegetariano,
Buffet desayuno premium.
end note
@enduml
