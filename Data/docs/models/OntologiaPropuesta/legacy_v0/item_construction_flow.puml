@startuml ItemConstructionFlow
skinparam backgroundColor white
skinparam ArrowColor #666666
skinparam defaultFontName Arial

title Construccion de un ITEM_CATALOGO
start
:Elegir CATEGORIA_COMERCIAL
(solo navegacion);
:Elegir TIPO_BASE;
:Asignar FACETAS;
:Asignar DIMENSIONES aplicables;
if (Requiere locacion?) then (si)
  :Vincular LOCACION;
endif
if (Requiere horario?) then (si)
  :Vincular HORARIO;
endif
if (Requiere cliente?) then (si)
  :Vincular TIPO_CLIENTE;
endif
:Asignar TIPO_VALORIZACION;
:Asignar PERFIL_PRECIO;
:Asignar INFRA requerida;
:Asignar REGLAS_NEGOCIO;
:Publicar ITEM_CATALOGO;
stop
@enduml
