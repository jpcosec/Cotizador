@startuml InheritanceComponents
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam ArrowColor #666666
skinparam defaultFontName Arial
left to right direction

title Herencia y override por capa

package "Fuentes" {
  [Area]
  [OP_CLASS]
  [Categoria]
}

package "Aspectos del contrato" {
  [Propiedades Activas]
  [Propiedades Descriptivas]
  [Ruling]
  [Pricing]
  [NamingContexto]
  [Composicion]
}

package "Resultado" {
  [ContratoItem]
  [ItemCatalogo]
  [LineaCotizada]
}

[OP_CLASS] --> [Propiedades Activas] : define
[OP_CLASS] --> [Propiedades Descriptivas] : define
[OP_CLASS] --> [Ruling] : patron base
[OP_CLASS] --> [Pricing] : patron base
[OP_CLASS] --> [Composicion] : define

[Area] --> [Ruling] : agrega dominio
[Area] --> [NamingContexto] : semantica

[Categoria] --> [Ruling] : modula
[Categoria] --> [Pricing] : modula
[Categoria] --> [NamingContexto] : comercializa
[Categoria] --> [Composicion] : restringe OP_CLASS valido
[Categoria] --> [Propiedades Activas] : default/constraint override
[Categoria] --> [Propiedades Descriptivas] : default override

[Propiedades Activas] --> [ContratoItem]
[Propiedades Descriptivas] --> [ContratoItem]
[Ruling] --> [ContratoItem]
[Pricing] --> [ContratoItem]
[NamingContexto] --> [ContratoItem]
[Composicion] --> [ContratoItem]

[ContratoItem] --> [ItemCatalogo] : instancia catalogable
[ItemCatalogo] --> [Propiedades Activas] : default override
[ItemCatalogo] --> [Propiedades Descriptivas] : default override
[ItemCatalogo] --> [LineaCotizada] : compra concreta
[LineaCotizada] --> [Propiedades Activas] : runtime override
[LineaCotizada] --> [Ruling] : activa evaluacion
[LineaCotizada] --> [Pricing] : activa calculo

note right of [Propiedades Activas]
Nacen en OP_CLASS.
Interactuan con pricing y/o ruling.
end note

note right of [Propiedades Descriptivas]
Tambien nacen en OP_CLASS.
Por ahora no alteran calculo.
end note
@enduml
