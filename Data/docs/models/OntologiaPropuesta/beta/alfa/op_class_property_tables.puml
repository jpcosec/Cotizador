@startuml OPClassPropertyTables
hide circle
skinparam backgroundColor white
skinparam classBackgroundColor #FDFDFD
skinparam classBorderColor #4F81BD
skinparam ArrowColor #666666
skinparam classAttributeIconSize 0
left to right direction

title Propiedades por OP_CLASS y override

class OP_CLASS {
  +ID_OP_CLASS : string
  Nombre : string
}

class PROPIEDAD {
  +ID_Propiedad : string
  Nombre : string
  Tipo_Dato : string
  Clase : activa|descriptiva
  Override_Mode : fixed|category_default|item_default|quote_runtime|derived_only
}

class OPCLASS_PROPIEDAD {
  +ID_OPClass_Propiedad : string
  ID_OP_CLASS : fk
  ID_Propiedad : fk
  Es_Requerida : boolean
  Rol : estructural|opcional
}

class SERVICIO_PROFILE {
  activas = pax, fecha, hora_inicio,
            duracion, locacion_id?,
            bloque_horario?
  override = categoria, item, linea
}

class PRODUCTO_PROFILE {
  activas = cantidad, fecha?, pax?
  descriptivas = unidad, sku,
                 temperatura_servicio,
                 bodega_origen
  override = item, linea
}

class RECURSO_PROFILE {
  activas = subtipo_recurso,
            fecha?, hora_inicio?,
            duracion?, capacidad_min?,
            capacidad_max?
  override = item, linea parcial
}

class COMPUESTO_PROFILE {
  activas = componentes, pax,
            fecha, hora_inicio,
            duracion, locacion_id
  override = item, linea
}

OP_CLASS "1" -- "0..*" OPCLASS_PROPIEDAD : exige
PROPIEDAD "1" -- "0..*" OPCLASS_PROPIEDAD : describe
OP_CLASS ..> SERVICIO_PROFILE : servicio
OP_CLASS ..> PRODUCTO_PROFILE : producto
OP_CLASS ..> RECURSO_PROFILE : recurso
OP_CLASS ..> COMPUESTO_PROFILE : compuesto
@enduml
