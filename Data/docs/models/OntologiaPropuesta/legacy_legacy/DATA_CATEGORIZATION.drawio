        <mxCell id="n8" value="&lt;b&gt;Politica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Categorias fuente:&lt;/font&gt;&lt;br&gt;- cotizacion_tipo_dia_1&lt;br&gt;- cotizacion_tipo_presupuesto_valorizado&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Ejemplos:&lt;/font&gt;&lt;br&gt;- Buffet dia 1&lt;br&gt;- Bar abierto VIP 4 horas&lt;br&gt;- Bloques de cotizacion tipo&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Total items: 30&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Nota: aqui se mezclan items comerciales con bloques/politicas de cotizacion extraidos desde hojas de plantilla.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
