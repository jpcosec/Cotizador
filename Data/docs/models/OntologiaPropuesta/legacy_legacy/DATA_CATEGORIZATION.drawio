        <mxCell id="n6" value="&lt;b&gt;Wellness&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Categoria fuente:&lt;/font&gt;&lt;br&gt;- precios_spa&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Ejemplos:&lt;/font&gt;&lt;br&gt;- Masajes relax 30 min&lt;br&gt;- Masajista exclusiva&lt;br&gt;- Piscina temperada nocturna&lt;br&gt;- Gorros de piscina&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Total items: 8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
