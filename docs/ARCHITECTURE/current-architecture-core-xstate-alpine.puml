@startuml
title Cotizador Lodge - Core Source / XState / Alpine View

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam component {
  FontColor #1F2937
  BorderColor #94A3B8
}
skinparam database {
  FontColor #1F2937
  BorderColor #94A3B8
}

legend left
|= Group |= Meaning |= Color |
|<back:#FEF3C7> `src/components/` | domain components and UI-facing controllers | amber |
|<back:#DBEAFE> `src/database/` | seed loading, resolver, persistence serialization/adapters | blue |
|<back:#FCE7F3> `src/pricing/` | pure pricing and quantity logic | pink |
|<back:#DCFCE7> `src/services/` | app services such as CSV/export helpers | green |
|<back:#EDE9FE> `src/state/` | quotation runtime orchestration and flow state | violet |
|<back:#F3F4F6> XState layer | machines / actors / event transitions | gray |
|<back:#CCFBF1> Alpine layer | templates and browser-facing binding shell | teal |

  Edge colors:
  - gray   : XState / actor orchestration
  - teal   : Alpine composition / UI binding
  - dark green : runtime/data calls
  - orange : export/build-facing calls
endlegend

package "Alpine / Browser Shell" {
  component "GAS HTML Templates\n`gas/Index.html` + `gas/*.html`" as GasTemplates #CCFBF1
  component "Flow Component Adapter\n`gas/scripts/createQuotationFlowComponent.js`" as FlowAdapter #CCFBF1
  component "Playground Mounts\n`playground/*/mount*.js`" as PlaygroundMounts #CCFBF1
}

package "XState / Runtime Orchestration" {
  component "Persisted Quotation Runtime\n`src/state/createPersistedQuotationRuntime.js`" as PersistedRuntime #EDE9FE
  component "Internal Quotation Runtime\n`src/state/createQuotationInternalRuntime.js`" as InternalRuntime #EDE9FE
  component "Flow Machine\nsave/load + stage transitions" as FlowMachine #F3F4F6
  component "Catalog Machine\n`src/components/catalog/machine/*`" as CatalogMachine #F3F4F6
  component "Basket Machine\n`src/components/basket/machine/*`" as BasketMachine #F3F4F6
  component "Category Machine\n`src/components/category/machine/*`" as CategoryMachine #F3F4F6
  component "Basket Day Machine\n`src/components/basket-day/machine/*`" as BasketDayMachine #F3F4F6
  component "Item Machine\n`src/components/item/machine/*`" as ItemMachine #F3F4F6
}

package "Core Source Layers (`src/`)" {
  package "components" {
    component "Quotation View Controllers\nsidebar / timeline / itemList / modals" as QuotationViews #FEF3C7
    component "Catalog + Basket Components" as CatalogBasketComponents #FEF3C7
    component "Item Domain Component\n`src/components/item/*`" as ItemComponent #FEF3C7
    component "Rules Engine\n`src/components/item/domain/rulesEngine/*`" as RulesEngine #FEF3C7
  }

  package "database" {
    component "Resolver + Seed Adapters\n`src/database/src/*`" as DatabaseLayer #DBEAFE
    component "Persistence Adapters\nlocal / GAS / serialization" as PersistenceAdapters #DBEAFE
  }

  package "pricing" {
    component "Pricing Formulas\n`src/pricing/src/*`" as PricingLayer #FCE7F3
  }

  package "services" {
    component "Excel/CSV Export\n`src/services/excelService.js`" as ExcelService #DCFCE7
  }

  package "state" {
    component "Snapshot Projection\nvalidation rows / app snapshot" as SnapshotProjection #EDE9FE
  }
}

database "Seed / Local Data\n`data/init/*.csv`, `data/db.json`" as LocalData #DBEAFE
database "Google Sheets / GAS\n`gas/Code.gs`" as GasSheets #DBEAFE

GasTemplates -[#2A9D8F]-> FlowAdapter : `x-data="quotationFlowComponent()"`
PlaygroundMounts -[#2A9D8F]-> ItemComponent : playground usage
FlowAdapter -[#2A9D8F]-> QuotationViews : compose display controllers
FlowAdapter -[#2A9D8F]-> PersistedRuntime : user actions -> runtime API
FlowAdapter -[#F59E0B]-> ExcelService : export CSV

PersistedRuntime -[#6B7280]-> FlowMachine : owns stage actor
PersistedRuntime -[#6B7280]-> InternalRuntime : wraps editable runtime
PersistedRuntime -[#166534]-> PersistenceAdapters : save / load quotations

InternalRuntime -[#6B7280]-> CatalogMachine : catalog orchestration
InternalRuntime -[#6B7280]-> BasketMachine : basket orchestration
InternalRuntime -[#166534]-> SnapshotProjection : build app snapshot
InternalRuntime -[#166534]-> DatabaseLayer : resolve definitions / reference data

CatalogMachine -[#6B7280]-> CategoryMachine : category actor graph
BasketMachine -[#6B7280]-> BasketDayMachine : day actor graph
CategoryMachine -[#6B7280]-> ItemMachine : catalog item actors
BasketDayMachine -[#6B7280]-> ItemMachine : basket item actors

ItemMachine -[#166534]-> ItemComponent : state for item component
ItemComponent -[#166534]-> PricingLayer : quantity / pricing computation
ItemComponent -[#166534]-> RulesEngine : evaluate availability / warnings / errors
ItemComponent -[#166534]-> DatabaseLayer : resolved definitions / kit composition

QuotationViews -[#166534]-> PersistedRuntime : read snapshots / invoke runtime methods
CatalogBasketComponents -[#166534]-> CatalogMachine : component snapshots
CatalogBasketComponents -[#166534]-> BasketMachine : component snapshots

DatabaseLayer -[#166534]-> LocalData : seeds / local records
PersistenceAdapters -[#166534]-> LocalData : local mode
PersistenceAdapters -[#166534]-> GasSheets : GAS mode

note right of FlowAdapter
  Alpine should remain a projection layer:
  render snapshot state, dispatch user intent,
  avoid holding business truth.
end note

note bottom of PersistedRuntime
  This is the public application runtime.
  It merges internal quotation behavior with
  persistence flow states like loading/saving/completed.
end note

note bottom of ItemComponent
  Component pattern in this repo:
  XState machine + pure domain logic + Alpine projection.
end note

@enduml
