@startuml DataModelMap
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam ArrowColor #666666
skinparam defaultFontName Arial
left to right direction

title Mapa actual del data model

package "Ontologia operacional" {
  [Propiedad Activa]
  [Propiedad Descriptiva]
  [OP_CLASS]
  [Area]
  [Ruling]
  [Pricing]
  [Categoria]
  [ContratoItem]
  [ItemCatalogo]
}

package "Ontologia de cotizacion" {
  [Cotizacion]
  [LineaCotizada]
}

[OP_CLASS] --> [Propiedad Activa]
[OP_CLASS] --> [Propiedad Descriptiva]
[OP_CLASS] --> [Ruling]
[OP_CLASS] --> [Pricing]
[Area] --> [Ruling]
[Categoria] --> [Area]
[Categoria] --> [OP_CLASS]
[Categoria] --> [Ruling]
[Categoria] --> [Pricing]
[Area] --> [ContratoItem]
[OP_CLASS] --> [ContratoItem]
[Categoria] --> [ContratoItem]
[ContratoItem] --> [ItemCatalogo]
[ItemCatalogo] --> [LineaCotizada]
[LineaCotizada] --> [Cotizacion]
@enduml
