@startuml
title Quotation Flow - Component Responsibility Map by Stage

skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 12
}

legend left
  Tags = stages where the component participates
  Nesting = conceptual containment / ownership
  <#F59E0B> app/core unit
  <#60A5FA> boundary unit
  <#EC4899> decision engine
endlegend

package "QuotationFlow\n[browse, client, basket, validation, completed]" #F59E0B {

  component "ClientSelection\n[client]" as ClientSelection #F59E0B

  component "ValidationSummary\n[validation]" as ValidationSummary #F59E0B

  component "PricingEngine\n[basket, validation]" as PricingEngine #EC4899

  package "Catalog\n[basket]" #F59E0B {
    component "Category\n[basket]" as Category #F59E0B
    component "Item\n[catalog mode]\n[basket]" as CatalogItem #F59E0B
  }

  package "Basket\n[basket, validation]" #F59E0B {
    component "BasketDay\n[basket, validation]" as BasketDay #F59E0B
    component "Item\n[basket mode]\n[basket, validation]" as BasketItem #F59E0B
  }
}

component "Store\n[browse, client, basket]" as Store #60A5FA
component "Persistence\n[browse, validation, completed]" as Persistence #60A5FA
component "Export\n[validation]" as Export #60A5FA

QuotationFlow --> Store
QuotationFlow --> Persistence
QuotationFlow --> Export
QuotationFlow --> PricingEngine
QuotationFlow --> ClientSelection
QuotationFlow --> ValidationSummary
QuotationFlow --> Catalog
QuotationFlow --> Basket

Catalog --> Category
Category --> CatalogItem

Basket --> BasketDay
BasketDay --> BasketItem

@enduml