@startuml
title App View to Units Map - Outer Layer

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam rectangle {
  FontColor #1F2937
  BorderColor #94A3B8
}
skinparam component {
  FontColor #1F2937
  BorderColor #94A3B8
}

legend left
|= Group |= Meaning |= Color |
|<back:#EDE9FE> App View | Outer-layer pipeline stage | violet |
|<back:#FEF3C7> Core Unit | Product/app unit in that stage | amber |
|<back:#DBEAFE> Boundary Unit | Store/persistence boundary | blue |
|<back:#FCE7F3> Decision Engine | Pricing/rules engine | pink |

  Edge meaning:
  - solid gray: pipeline progression
  - solid blue: unit present in view
endlegend

rectangle "browse" as Browse #EDE9FE
rectangle "client" as Client #EDE9FE
rectangle "basket" as BasketView #EDE9FE
rectangle "validation" as Validation #EDE9FE
rectangle "completed" as Completed #EDE9FE

Browse -[#6B7280]-> Client
Client -[#6B7280]-> BasketView
BasketView -[#6B7280]-> Validation
Validation -[#6B7280]-> Completed

component "QuotationFlow" as QuotationFlow #FEF3C7
component "ClientSelection" as ClientSelection #FEF3C7
component "Catalog" as Catalog #FEF3C7
component "Category" as Category #FEF3C7
component "Item\n(catalog mode)" as CatalogItem #FEF3C7
component "Basket" as Basket #FEF3C7
component "BasketDay" as BasketDay #FEF3C7
component "Item\n(basket mode)" as BasketItem #FEF3C7
component "ValidationSummary" as ValidationSummary #FEF3C7
component "Store" as Store #DBEAFE
component "Persistence" as Persistence #DBEAFE
component "Export" as Export #DBEAFE
component "PricingEngine" as PricingEngine #FCE7F3

Browse -[#2563EB]-> QuotationFlow
Browse -[#2563EB]-> Persistence

Client -[#2563EB]-> QuotationFlow
Client -[#2563EB]-> ClientSelection
Client -[#2563EB]-> Store

BasketView -[#2563EB]-> QuotationFlow
BasketView -[#2563EB]-> Catalog
BasketView -[#2563EB]-> Category
BasketView -[#2563EB]-> CatalogItem
BasketView -[#2563EB]-> Basket
BasketView -[#2563EB]-> BasketDay
BasketView -[#2563EB]-> BasketItem
BasketView -[#2563EB]-> PricingEngine
BasketView -[#2563EB]-> Store

Validation -[#2563EB]-> QuotationFlow
Validation -[#2563EB]-> ValidationSummary
Validation -[#2563EB]-> Persistence
Validation -[#2563EB]-> Export

Completed -[#2563EB]-> QuotationFlow
Completed -[#2563EB]-> Persistence

note right of BasketView
  Densest outer-layer stage.
  This is where catalog selection,
  basket composition, scheduling,
  pricing, and rule evaluation converge.
end note

note right of Validation
  Review stage before final save.
  ValidationSummary, Export,
  and Persistence surface here.
end note

@enduml
