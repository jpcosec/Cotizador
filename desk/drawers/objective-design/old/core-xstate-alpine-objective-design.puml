@startuml
title Objective Design - Self-Contained Units

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam component {
  FontColor #1F2937
  BorderColor #94A3B8
}
skinparam database {
  FontColor #1F2937
  BorderColor #94A3B8
}

legend left
|= Group |= Responsibility |= Color |
|<back:#CCFBF1> Alpine | Render UI and map user signals inward | teal |
|<back:#EDE9FE> XState | Hold state, process signals, orchestrate updates | violet |
|<back:#FCE7F3> Pricing Engine | Compute prices and rule activations from input data | pink |
|<back:#DBEAFE> Store | Load on init/on demand, query selective data, persist on request | blue |
|<back:#FEF3C7> Self-Contained Unit | Deployable component boundary | amber |

  Edge colors:
  - teal   : UI rendering and signal mapping
  - gray   : state/orchestration
  - pink   : pricing/rules interaction
  - blue   : store query/load/persist
endlegend

rectangle "Self-Contained Unit" as Unit #FEF3C7 {
  component "Alpine Adapter\n- render state\n- capture user signals\n- forward intent inward" as Alpine #CCFBF1
  component "XState Machine\n- hold authoritative state\n- receive user/component signals\n- decide transitions\n- order UI updates" as XState #EDE9FE
}

component "Pricing Engine\n- pure pricing logic\n- pure rule evaluation\n- input -> derived value / rule activation" as Pricing #FCE7F3
database "Store\n- initialize load\n- explicit load on request\n- selective query API\n- persist on request" as Store #DBEAFE
database "Lower-Level Source\nfiles / Sheets / external persistence" as LowerLevel #DBEAFE
actor "User" as User
component "Another Component" as OtherComponent #FEF3C7

User -[#2A9D8F]-> Alpine : user signals
Alpine -[#2A9D8F]-> XState : mapped intent
XState -[#2A9D8F]-> Alpine : state snapshot / UI update order

OtherComponent -[#6B7280]-> XState : component signal
XState -[#6B7280]-> OtherComponent : emitted signal / coordination

XState -[#C026D3]-> Pricing : compute price / evaluate rules
Pricing -[#C026D3]-> XState : derived values / rule activations

XState -[#2563EB]-> Store : query / load / persist request
Store -[#2563EB]-> XState : requested records / persistence result
Store -[#2563EB]-> LowerLevel : load on init
Store -[#2563EB]-> LowerLevel : load on explicit request
Store -[#2563EB]-> LowerLevel : persist on explicit request

note right of Alpine
  Alpine is not the source of truth.
  It is the membrane between UI and state.
end note

note right of XState
  XState is the behavioral core.
  It owns state and decides when to consult
  pricing or store services.
end note

note bottom of Store
  Store is not the raw database.
  It is a bounded access layer:
  do not ask for the whole store by default,
  ask for one item, many items, or a family.
end note

@enduml
