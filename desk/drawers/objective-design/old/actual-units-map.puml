@startuml
title Actual State - Conceptual Units Map

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam component {
  FontColor #1F2937
  BorderColor #94A3B8
}
skinparam rectangle {
  FontColor #1F2937
  BorderColor #94A3B8
}

legend left
|= Group |= Meaning |= Color |
|<back:#FEF3C7> Real unit | Present and active in the current design | amber |
|<back:#FDE68A> Strong atomic unit | Best current fit for self-contained-unit model | yellow |
|<back:#FBCFE8> Split decision logic | Pricing/rules exist but are distributed | pink |
|<back:#BFDBFE> Split store boundary | Data/store concerns exist but are fragmented | blue |
|<back:#E5E7EB> Partial unit | Exists mostly as glue, projection, or embedded behavior | gray |

  Edge meaning:
  - solid blue: current coordination / composition
  - pink: pricing/rules dependency
  - blue: data/persistence dependency
endlegend

component "QuotationFlow\n(overloaded app shell)" as QuotationFlow #FEF3C7

component "ClientSelection\n(embedded modal behavior)" as ClientSelection #E5E7EB
component "Catalog" as Catalog #FEF3C7
component "Category" as Category #FEF3C7
component "Item\n(strongest self-contained unit)" as Item #FDE68A
component "Basket" as Basket #FEF3C7
component "BasketDay" as BasketDay #FEF3C7
component "ValidationSummary\n(derived projection)" as ValidationSummary #E5E7EB
component "Persistence" as Persistence #FEF3C7
component "Export\n(CSV + print)" as Export #E5E7EB

component "Pricing + Item Rules\n(distributed across pricing/item domain)" as PricingRules #FBCFE8
component "Resolver / Database" as ResolverDatabase #BFDBFE
component "Persistence Adapters" as PersistenceAdapters #BFDBFE

QuotationFlow -[#4C78A8]-> ClientSelection
QuotationFlow -[#4C78A8]-> Catalog
QuotationFlow -[#4C78A8]-> Basket
QuotationFlow -[#4C78A8]-> ValidationSummary
QuotationFlow -[#4C78A8]-> Persistence
QuotationFlow -[#4C78A8]-> Export

Catalog -[#4C78A8]-> Category
Category -[#4C78A8]-> Item
Basket -[#4C78A8]-> BasketDay
BasketDay -[#4C78A8]-> Item

Item -[#C026D3]-> PricingRules : compute / evaluate

QuotationFlow -[#2563EB]-> ResolverDatabase : runtime queries
Catalog -[#2563EB]-> ResolverDatabase : item/category lookup
Category -[#2563EB]-> ResolverDatabase : resolved definitions
Item -[#2563EB]-> ResolverDatabase : definition / kit composition

Persistence -[#2563EB]-> PersistenceAdapters : save / load
PersistenceAdapters -[#2563EB]-> ResolverDatabase : serialize / hydrate

ValidationSummary -[#4C78A8]-> Basket : read derived state
Export -[#4C78A8]-> ValidationSummary : export current review

note right of QuotationFlow
  Real and central, but currently carries
  more glue/orchestration than the target model wants.
end note

note right of ValidationSummary
  More read-model/projection than autonomous unit.
end note

note bottom of ResolverDatabase
  Conceptual "Store" is not yet expressed as one
  explicit bounded facade. It is split across resolver,
  database, and persistence modules.
end note

@enduml
