@startuml
title Desired Architecture - Self-Contained Units Map

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam component {
  FontColor #1F2937
  BorderColor #94A3B8
}
skinparam rectangle {
  FontColor #1F2937
  BorderColor #94A3B8
}

legend left
|= Group |= Meaning |= Color |
|<back:#FEF3C7> App / Composite Unit | Product-facing unit with its own boundary | amber |
|<back:#FDE68A> Atomic Unit | Small reusable self-contained unit | yellow |
|<back:#FCE7F3> Decision Engine | Pure pricing and rules logic | pink |
|<back:#DBEAFE> Store Boundary | Selective load/query/persist access | blue |

  Edge meaning:
  - solid blue: composition / coordination
  - pink: decision-engine usage
  - blue: store usage
endlegend

component "QuotationFlow" as QuotationFlow #FEF3C7

component "ClientSelection" as ClientSelection #FEF3C7
component "Catalog" as Catalog #FEF3C7
component "Basket" as Basket #FEF3C7
component "ValidationSummary" as ValidationSummary #FEF3C7
component "Persistence" as Persistence #FEF3C7
component "Export" as Export #FEF3C7

package "Catalog Composition" {
  component "Category" as Category #FEF3C7
  component "Item" as CatalogItem #FDE68A
}

package "Basket Composition" {
  component "BasketDay" as BasketDay #FEF3C7
  component "Item" as BasketItem #FDE68A
}

component "PricingEngine" as PricingEngine #FCE7F3
component "Store" as Store #DBEAFE

QuotationFlow -[#4C78A8]-> ClientSelection
QuotationFlow -[#4C78A8]-> Catalog
QuotationFlow -[#4C78A8]-> Basket
QuotationFlow -[#4C78A8]-> ValidationSummary
QuotationFlow -[#4C78A8]-> Persistence
QuotationFlow -[#4C78A8]-> Export

Catalog -[#4C78A8]-> Category : contains
Category -[#4C78A8]-> CatalogItem : contains

Basket -[#4C78A8]-> BasketDay : contains
BasketDay -[#4C78A8]-> BasketItem : contains

CatalogItem -[#C026D3]-> PricingEngine : compute / evaluate rules
BasketItem -[#C026D3]-> PricingEngine : compute / evaluate rules

QuotationFlow -[#2563EB]-> Store : app-level queries
ClientSelection -[#2563EB]-> Store : query clients
Catalog -[#2563EB]-> Store : query items / families
Persistence -[#2563EB]-> Store : load / persist quotations

ValidationSummary -[#4C78A8]-> Basket : read review state
Export -[#4C78A8]-> ValidationSummary : export reviewed quotation

note right of Store
  Not a raw database.
  Selective access only:
  one item, many items, a family,
  or a persistence request.
end note

@enduml
