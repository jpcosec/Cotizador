@startuml
title App View Pipeline - Activity Diagram

skinparam shadowing false
skinparam linetype ortho
skinparam activity {
  FontColor #1F2937
  BorderColor #94A3B8
  BackgroundColor #EDE9FE
  DiamondBackgroundColor #DBEAFE
  DiamondBorderColor #94A3B8
}
skinparam note {
  FontColor #1F2937
  BorderColor #94A3B8
  BackgroundColor #FEF3C7
}

start

:browse;
note right
  Units:
  - QuotationFlow
  - Persistence
end note

if (client chosen?) then (yes)
  :client;
  note right
    Units:
    - QuotationFlow
    - ClientSelection
    - Store
  end note
else (load path)
  :client;
  note right
    Load/search path still resolves
    into the client-selection stage.
  end note
endif

:basket;
note right
  Units:
  - QuotationFlow
  - Catalog
  - Category
  - Item (catalog mode)
  - Basket
  - BasketDay
  - Item (basket mode)
  - PricingEngine
  - Store
end note

if (validate?) then (yes)
  :validation;
  note right
    Units:
    - QuotationFlow
    - ValidationSummary
    - Persistence
    - Export
  end note
else (keep editing)
  --> basket
endif

if (save confirmed?) then (yes)
  :completed;
  note right
    Units:
    - QuotationFlow
    - Persistence
  end note
else (back)
  --> basket
endif

stop

@enduml
