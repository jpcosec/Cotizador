@startuml
title Deployment Diagram Example

node Browser {
  artifact "Alpine UI"
}

node "Local Server" {
  artifact "Vite / serve-local"
  artifact "Bundle_Runtime.html"
}

node "Google Apps Script" {
  artifact "Code.gs"
  artifact "Quotation_App.html"
}

database "Google Sheets" as Sheets

Browser --> "Local Server"
Browser --> "Google Apps Script"
"Google Apps Script" --> Sheets
@enduml
