{
  "name": "Full Quotation Lifecycle",
  "baseUrl": "http://localhost:8082",
  "steps": [
    {
      "id": "01_open_app",
      "action": "goto",
      "url": "/",
      "description": "Open the GAS application"
    },
    {
      "id": "02_select_client",
      "action": "click",
      "selector": "button:has-text('Select Client')",
      "description": "Open client selection modal"
    },
    {
      "id": "03_pick_client",
      "action": "click",
      "selector": ".client-item:has-text('test1')",
      "description": "Pick 'test1' client"
    },
    {
      "id": "04_wait_workspace",
      "action": "wait",
      "selector": ".workspace",
      "description": "Wait for workspace"
    },
    {
      "id": "05_expand_category",
      "action": "click",
      "selector": ".category-head >> nth=0",
      "description": "Expand first category"
    },
    {
      "id": "06_wait_items",
      "action": "wait_fixed",
      "value": 3000,
      "description": "Wait for catalog items"
    },
    {
      "id": "07_add_item",
      "action": "click",
      "selector": "button[aria-label='Ship to basket'] >> nth=0",
      "description": "Add item"
    },
    {
      "id": "08_wait_basket_sync",
      "action": "wait_fixed",
      "value": 3000,
      "description": "Wait for basket sync"
    },
    {
      "id": "09_go_validation",
      "action": "click",
      "selector": ".workspace .settings-actions button:has-text('Validate')",
      "description": "Advance to validation"
    },
    {
      "id": "10_wait_validation",
      "action": "wait",
      "selector": ".validation-panel h2",
      "description": "Wait for validation screen"
    },
    {
      "id": "11_export_to_excel",
      "action": "click",
      "selector": ".validation-panel .validation-actions button:has-text('Export to Excel')",
      "description": "Export validation rows to csv"
    },
    {
      "id": "12_save_quotation",
      "action": "click",
      "selector": ".validation-panel .validation-actions button:has-text('Confirm & Save')",
      "description": "Save quotation"
    },
    {
      "id": "13_verify_saved",
      "action": "wait",
      "selector": ".validation-panel h2:has-text('Quotation Saved')",
      "description": "Verify save"
    },
    {
      "id": "14_edit_pack_db",
      "action": "goto",
      "url": "/playground/routes/pack-editor.html",
      "description": "Open pack editor database flow"
    }
  ]
}
